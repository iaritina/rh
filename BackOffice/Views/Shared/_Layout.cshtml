<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BackOffice</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BackOffice.styles.css" asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Header -->
    <header class="header d-flex justify-content-between align-items-center px-3 py-2 bg-dark text-white">
        <h5 class="m-0">Back-Office</h5>

        <!-- Profil dropdown -->
        <div class="dropdown">
            <a class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi-person-circle me-2"></i> Utilisateur
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li>
                    <a class="dropdown-item d-flex align-items-center" asp-controller="Profile" asp-action="Index">
                        <i class="bi-person me-2"></i> Mon profil
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center" asp-controller="Settings" asp-action="Index">
                        <i class="bi-gear me-2"></i> Paramètres
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Logout">
                        <i class="bi-box-arrow-right me-2"></i> Déconnexion
                    </a>
                </li>
            </ul>
        </div>
    </header>

    <!-- Sidebar -->
    <aside class="sidebar">
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Monitoring" ? "active" : "")"
                   asp-controller="Monitoring" asp-action="Index">
                    <i class="bi bi-clipboard-data me-2"></i> Monitoring
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                   asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people me-2"></i> Employés
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Conge" ? "active" : "")"
                   asp-controller="Conge" asp-action="Index">
                    <i class="bi bi-calendar2-check me-2"></i> Solde
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DemandeConge" ? "active" : "")"
                   asp-controller="DemandeConge" asp-action="Index">
                    <i class="bi bi-calendar2-check me-2"></i> Demande
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Registration" ? "active" : "")"
                   asp-controller="Registration" asp-action="Create">
                    <i class="bi bi-fingerprint me-2"></i> Pointage
                </a>
            </li>
        </ul>
    </aside>


    <!-- Main Content -->
    <main class="main-content p-3">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
