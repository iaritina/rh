@model BackOffice.ViewModels.PagedResult<BackOffice.Models.User>

@{
    int pageSize = Model.PageSize;
    int totalUsers = Model.TotalItems;
    int currentPage = Model.Page;
    int totalPages = (int)Math.Ceiling((double)totalUsers / pageSize);
    var sizes = new int[] { 5, 10, 20, 50 };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-gray-800 font-bold text-xl">Liste des Employés</h2>
        <button type="button" class="btn btn-primary shadow-sm" id="openCreatePanel">
            <i class="bi bi-plus-circle me-1"></i> Ajouter un Employé
        </button>
    </div>

    <div class="table-responsive rounded-lg shadow-sm">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-gray-600 font-semibold">Nom</th>
                    <th class="text-gray-600 font-semibold">Prénom</th>
                    <th class="text-gray-600 font-semibold">Email</th>
                    <th class="text-gray-600 font-semibold">Téléphone</th>
                    <th class="text-center text-gray-600 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-gray-500">
                            <i class="bi bi-person-x fs-1 mb-2"></i>
                            <p>Aucun employé trouvé.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model.Items)
                    {
                        <tr class="border-bottom">
                            <td class="fw-semibold">@user.FirstName</td>
                            <td class="fw-semibold">@user.LastName</td>
                            <td class="text-muted">@user.Email</td>
                            <td class="text-muted">@user.Phone</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- Bouton Éditer -->
                                    <a asp-action="Edit" asp-route-id="@user.Id" 
                                       class="btn btn-outline-primary btn-sm rounded-circle p-2 shadow-sm border-0"
                                       style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; transition: all 0.2s;"
                                       title="Modifier">
                                        <i class="bi bi-pencil-fill fs-6"></i>
                                    </a>

                                    <!-- Bouton Supprimer -->
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm rounded-circle p-2 shadow-sm border-0"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-user-id="@user.Id"
                                            data-user-name="@user.FirstName @user.LastName"
                                            style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; transition: all 0.2s;"
                                            title="Supprimer">
                                        <i class="bi bi-trash-fill fs-6"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <div class="d-flex align-items-center gap-4">
            <div class="d-flex align-items-center text-muted">
                <i class="bi bi-clipboard-data me-1"></i>
                <span><strong class="text-dark">@totalUsers</strong> résultat(s)</span>
            </div>

            <div class="d-flex align-items-center">
                <label for="pageSizeSelect" class="me-2 text-muted small">Afficher :</label>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="pageSizeDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @pageSize
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="pageSizeDropdown">
                        @foreach (var size in sizes)
                        {
                            <li>
                                <a class="dropdown-item @(size == pageSize ? "active" : "")" href="?pageNumber=1&pageSize=@size">@size</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-end mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-pageSize="@pageSize">&laquo;</a>
                </li>
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(currentPage - 1)" asp-route-pageSize="@pageSize">&lt;</a>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">Page @currentPage sur @totalPages</span>
                </li>

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(currentPage + 1)" asp-route-pageSize="@pageSize">&gt;</a>
                </li>
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@totalPages" asp-route-pageSize="@pageSize">&raquo;</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- Modal de suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Supprimer cet employé ?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer cet employé ?</p>
                <strong id="userNameToDelete"></strong>
                <p class="mt-3 text-danger"><small>Cette action est irréversible.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" name="id" id="deleteUserId" />
                    <button type="submit" class="btn btn-danger">Confirmer</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Panneau latéral de création -->
<div id="createPanel" class="create-panel">
    <div class="create-panel-header">
        <h4 class="text-white mb-0">Ajouter un employé</h4>
        <button type="button" class="btn-close btn-close-white" id="closeCreatePanel"></button>
    </div>
    <div class="create-panel-body">
        <form asp-action="Create" method="post" class="needs-validation" novalidate>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="FirstName" class="form-label text-gray-700">Nom</label>
                    <input type="text" class="form-control shadow-sm" id="FirstName" name="FirstName" required>
                    <div class="invalid-feedback">Veuillez entrer le nom.</div>
                </div>

                <div class="col-md-6">
                    <label for="LastName" class="form-label text-gray-700">Prénom</label>
                    <input type="text" class="form-control shadow-sm" id="LastName" name="LastName" required>
                    <div class="invalid-feedback">Veuillez entrer le prénom.</div>
                </div>

                <div class="col-md-12">
                    <label for="Email" class="form-label text-gray-700">E-mail</label>
                    <input type="email" class="form-control shadow-sm" id="Email" name="Email" required>
                    <div class="invalid-feedback">Veuillez entrer un e-mail valide.</div>
                </div>

                <div class="col-md-12">
                    <label for="Phone" class="form-label text-gray-700">Téléphone</label>
                    <input type="tel" class="form-control shadow-sm" id="Phone" name="Phone" required>
                    <div class="invalid-feedback">Veuillez entrer un numéro de téléphone.</div>
                </div>

                <div class="col-md-12">
                    <label for="HiringDate" class="form-label text-gray-700">Date d'embauche</label>
                    <input type="date" class="form-control shadow-sm" id="HiringDate" name="HiringDate">
                </div>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary shadow-sm py-2">Ajouter l'employé</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Afficher le panneau de création
        document.getElementById('openCreatePanel').addEventListener('click', function () {
            document.getElementById('createPanel').classList.add('show');
        });

        // Fermer le panneau de création
        document.getElementById('closeCreatePanel').addEventListener('click', function () {
            document.getElementById('createPanel').classList.remove('show');
        });

        // Fermer le panneau si on clique en dehors
        document.addEventListener('click', function (e) {
            const panel = document.getElementById('createPanel');
            const button = document.getElementById('openCreatePanel');
            if (panel.classList.contains('show') && !panel.contains(e.target) && e.target !== button) {
                panel.classList.remove('show');
            }
        });

        // Validation du formulaire
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteModal = document.getElementById('deleteModal');
            const userNameElement = document.getElementById('userNameToDelete');
            const deleteUserIdInput = document.getElementById('deleteUserId');

            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const userId = button.getAttribute('data-user-id');
                const userName = button.getAttribute('data-user-name');

                userNameElement.textContent = userName;
                deleteUserIdInput.value = userId;
            });
        });
    </script>
}

<style>
    .create-panel {
        position: fixed;
        top: 0;
        right: -450px;
        width: 450px;
        height: 100vh;
        background: white;
        box-shadow: -10px 0 30px rgba(0,0,0,0.15);
        z-index: 1050;
        transition: right 0.3s ease-in-out;
        border-left: 2px solid #212529;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .create-panel.show {
        right: 0;
    }

    .create-panel-header {
        padding: 1.5rem;
        background: #212529;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .create-panel-header h4 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .create-panel-body {
        padding: 2rem;
        flex: 1;
        overflow-y: auto;
        background-color: #f8fafc;
    }

    .create-panel-body .form-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #374151;
    }

    .create-panel-body .form-control {
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
    }

    .create-panel-body .form-control:focus {
        border-color: #212529;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }

    .create-panel-body .btn {
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.2s;
    }

    .create-panel-body .btn-primary {
        background-color: #212529;
        border-color: #212529;
    }

    .create-panel-body .btn-primary:hover {
        background-color: #212529;
        border-color: #212529;
    }

    .create-panel-body .invalid-feedback {
        font-size: 0.875rem;
    }

    .table {
        border-collapse: separate;
        border-spacing: 0;
    }

    .table th {
        background-color: #f1f5f9;
        padding: 1rem 1.5rem;
    }

    .table td {
        padding: 1rem 1.5rem;
    }

    .table tr:not(:last-child) {
        border-bottom: 1px solid #e2e8f0;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

    .rounded-lg {
        border-radius: 0.5rem !important;
    }

    .shadow-sm {
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .shadow {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .text-gray-600 {
        color: #4b5563;
    }

    .text-gray-700 {
        color: #374151;
    }

    .text-gray-800 {
        color: #1f2937;
    }

    .fw-semibold {
        font-weight: 600;
    }

    .text-muted {
        color: #6b7280 !important;
    }

   
</style>