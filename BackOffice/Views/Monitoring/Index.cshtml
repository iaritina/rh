@model BackOffice.ViewModels.MonitoringViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="row g-4">
        <!-- Tableau Présents -->
        <div class="col-md-6">
            <div class="bg-white rounded-lg shadow-sm p-3 h-100">
                <h4 class="text-success fw-semibold mb-3">
                    Présents
                    <span class="badge bg-success" id="presentCount">
                        @Model.Users.Count(u => u.LastStatus == BackOffice.Models.RegistrationType.Enter)
                    </span>
                </h4>
                <table class="table table-bordered table-striped" id="presentTable">
                    <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Dernier Pointage</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in Model.Users.Where(u => u.LastStatus == BackOffice.Models.RegistrationType.Enter))
                    {
                    <tr>
                        <td>@u.LastName</td>
                        <td>@(u.LastRegistrationTime?.ToString("HH:mm dd/MM/yyyy") ?? "Aucun")</td>
                        <td><span class="badge bg-success">Présent</span></td>
                    </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tableau Absents -->
        <div class="col-md-6">
            <div class="bg-white rounded-lg shadow-sm p-3 h-100">
                <h4 class="text-danger fw-semibold mb-3">
                    Absents
                    <span class="badge bg-danger" id="absentCount">
                        @Model.Users.Count(u => u.LastStatus != BackOffice.Models.RegistrationType.Enter)
                    </span>
                </h4>
                <table class="table table-bordered table-striped" id="absentTable">
                    <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Dernier Pointage</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in Model.Users.Where(u => u.LastStatus != BackOffice.Models.RegistrationType.Enter))
                    {
                    <tr>
                        <td>@u.LastName</td>
                        <td>@(u.LastRegistrationTime?.ToString("HH:mm dd/MM/yyyy") ?? "Aucun")</td>
                        <td><span class="badge bg-danger">Absent</span></td>
                    </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- SignalR -->
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr/dist/browser/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/monitoringHub")
        .build();

    connection.on("RefreshStatus", data => {
        const presentBody = document.querySelector("#presentTable tbody");
        const absentBody = document.querySelector("#absentTable tbody");

        // Présents
        presentBody.innerHTML = data.present.length
            ? data.present.map(u => `
                <tr>
                    <td>${u.lastName}</td>
                    <td>${u.lastRegistrationTime ?? "Aucun"}</td>
                    <td><span class="badge bg-success">Présent</span></td>
                </tr>`).join("")
            : `<tr><td colspan="3" class="text-center text-muted">Aucun</td></tr>`;

        // Absents
        absentBody.innerHTML = data.absent.length
            ? data.absent.map(u => `
                <tr>
                    <td>${u.lastName}</td>
                    <td>${u.lastRegistrationTime ?? "Aucun"}</td>
                    <td><span class="badge bg-danger">Absent</span></td>
                </tr>`).join("")
            : `<tr><td colspan="3" class="text-center text-muted">Aucun</td></tr>`;

        // Mettre à jour les badges
        document.getElementById("presentCount").textContent = data.present.length;
        document.getElementById("absentCount").textContent = data.absent.length;
    });

    connection.start().catch(err => console.error(err));
</script>

<style>
    .bg-white { background-color: #ffffff !important; }
    .rounded-lg { border-radius: 0.5rem !important; }
    .shadow-sm { box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05) !important; }
    .fw-medium { font-weight: 500; }
    .fw-semibold { font-weight: 600; }
    .bg-success { background-color: #10b981 !important; }
    .bg-danger { background-color: #ef4444 !important; }
    .table th, .table td { vertical-align: middle; }
</style>
