@using BackOffice.ViewModels
@model List<WorkDuration>

@{
ViewData["Title"] = "Durée de travail";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-gray-800 fw-bold fs-4">Temps de travail</h2>
    </div>

    <form method="get" class="mb-3 d-flex gap-2 align-items-end">
        <div class="d-flex flex-column">
            <input type="date" name="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <button type="submit" class="btn btn-dark btn-sm mt-1">Rechercher</button>
    </form>

    <div class="table-responsive rounded-lg shadow-sm">
        <table class="table table-hover mb-0">
            <thead class="table-light">
            <tr>
                <th class="text-gray-600 fw-semibold">Utilisateur</th>
                <th class="text-gray-600 fw-semibold">Durée de travail</th>
                <th class="text-gray-600 fw-semibold">Progression</th>
                <th class="text-center text-gray-600 fw-semibold"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
            string progressClass = item.Percentage < 50 ? "bg-danger" :
            item.Percentage < 80 ? "bg-warning" : "bg-success";

            <tr class="border-bottom">
                <td class="fw-semibold">@item.LastName</td>
                <td class="fw-semibold">
                    @item.TotalWorked.Hours:@item.TotalWorked.Minutes.ToString("00") /
                    @item.ScheduledTime.Hours:@item.ScheduledTime.Minutes.ToString("00")
                </td>
                <td class="text-muted">
                    <div class="d-flex align-items-center gap-2">
                        <!-- Pourcentage à gauche -->
                        <span class="fw-medium text-gray-700" style="width:40px;">@item.Percentage %</span>
                        <!-- Barre de progression -->
                        <div class="progress flex-fill" style="height: 20px; border-radius: 10px; overflow: hidden;">
                            <div class="progress-bar @(item.Percentage < 50 ? "bg-danger" : item.Percentage < 80 ? "bg-warning" : "bg-success")"
                                 role="progressbar"
                                 style="width:@item.Percentage%; transition: width 0.5s;"
                                 aria-valuenow="@item.Percentage" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                </td>


                <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Edit" asp-route-id=""
                           class="btn btn-outline-primary btn-sm rounded-circle p-2 shadow-sm border-0"
                           style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; transition: all 0.2s;"
                           title="Modifier">
                            <i class="bi bi-pencil-fill fs-6"></i>
                        </a>
                    </div>
                </td>
            </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<style>
    .table th {
        background-color: #f1f5f9;
        padding: 1rem 1.5rem;
    }

    .table td {
        padding: 1rem 1.5rem;
    }

    .table tr:not(:last-child) {
        border-bottom: 1px solid #e2e8f0;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

    .rounded-lg {
        border-radius: 0.5rem !important;
    }

    .shadow-sm {
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .fw-semibold {
        font-weight: 600;
    }

    .text-gray-600 {
        color: #4b5563;
    }

    .text-gray-800 {
        color: #1f2937;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 0.25rem;
        color: #374151;
    }

    .form-control {
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        border: 1px solid #e2e8f0;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

    .form-control:focus {
        border-color: #212529;
        box-shadow: 0 0 0 0.2rem rgba(0, 0, 0, 0.1);
    }

    .btn-dark {
        background-color: #212529;
        border-color: #212529;
        font-weight: 600;
    }

    .btn-dark:hover {
        background-color: #1f2937;
        border-color: #1f2937;
    }
</style>
